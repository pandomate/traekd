# Path to the directory watched by Traefik's file provider. Traekd writes traekd.yml inside it.
TRAEFIK_CONFIG_PATH=/etc/traefik/dynamic
# Security boundary for all dynamic config outputs. UI path changes cannot leave this directory.
TRAEKD_CONFIG_ROOT=/etc/traefik/dynamic
TRAEFIK_YML_FILE=./traefik.yml
# Keep API discovery/runtime requests on loopback or private networks by default.
# TRAEKD_ALLOW_PUBLIC_TRAEFIK_API=false
# Security boundary for static-config reads and validated Entry Point writes.
TRAEKD_STATIC_CONFIG_ROOT=.
TRAEKD_STORAGE_MODE=directory
TRAEKD_TRAEFIK_VERSION=v3.7
TRAEKD_MANAGED_DIRECTORY=/etc/traefik/dynamic
# Remembered path used when switching back to single-file mode
TRAEKD_SINGLE_FILE_PATH=./config.yml
# Optional read-only Traefik API endpoint
TRAEFIK_API_URL=

# Web server settings
SERVER_PORT=3000
SERVER_HOST=127.0.0.1

# Site information
SITE_TITLE='Traefik Config Manager'

# Authentication is required by default on every bind address. Generate the hash with:
# cd server && npm run hash-password -- "a long password"
TRAEKD_AUTH_MODE=required
TRAEKD_ADMIN_USER=
TRAEKD_ADMIN_PASSWORD_HASH=
TRAEKD_SESSION_SECRET=
